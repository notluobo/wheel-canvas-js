{
    "arrowParens": "avoid",
    "bracketSameLine": false,
    "endOfLine": "lf",
    "printWidth": 100,
    "proseWrap": "preserve",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false,
    "overrides": [
        {
            "files": "index.html",
            "options": {
                "htmlWhitespaceSensitivity": "ignore",
                "printWidth": 120
            }
        }
    ]
}
